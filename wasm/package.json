{
  "name": "mcpi-wasm",
  "version": "0.1.1",
  "description": "Minecraft Pi Edition API - WebAssembly Port",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "wasm-pack build --target bundler",
    "build:ts": "tsc",
    "dev": "concurrently \"npm run watch:wasm\" \"npm run watch:ts\"",
    "watch:wasm": "watchexec -e rs 'npm run build:wasm'",
    "watch:ts": "tsc --watch",
    "test": "jest",
    "demo": "python3 -m http.server 8000 --directory demo"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "@types/node": "^20.5.0",
    "@types/ws": "^8.5.5",
    "concurrently": "^8.2.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "wasm-pack": "^1.3.4",
    "watchexec-cli": "^1.4.1"
  }
}
